# Раннтайм-логи джоб (orchestration/) — не джерело істини, у контейнері
# створюються наново, прибираються джобою prune_logs через 14 днів.
logs/

# Локальні/тимчасові дампи БД поза db/backup/. Резерв, що КОМІТИТЬСЯ, —
# це db/backup/invest_agent_data.sql.gz (нижче явно розігнорений): без
# нього розгортання дає агента з короткими рядами, а історію
# спостережень повністю перезібрати неможливо (FRED/ECB віддають
# глибину, Binance/Twelve Data — ні).
backup.sql
backup_*.sql
*.sql.gz
!db/backup/*.sql.gz

# Діагностичні зліпки (TROUBLESHOOTING.md, «Коли нічого не допомогло»)
agent-diag-*.txt
