# Скопіюйте цей файл у .env і заповніть значення. .env вже в .gitignore.

# --- FRED (макро-дані США) ---
# Безкоштовна реєстрація: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Bank of Japan (Policy Rate, Японія) ---
# Ключ не потрібен, API відкритий без реєстрації.

# --- e-Stat (CPI, Японія) ---
# Безкоштовна реєстрація appId: https://www.e-stat.go.jp (My Page →
# API機能 → アプリケーションIDの発行, до 3 appId на акаунт).
ESTAT_APP_ID=

# --- SEC EDGAR (фундаментальні дані компаній) ---
# Ключ не потрібен, але SEC вимагає контактний User-Agent (без нього —
# 403). Формат: "назва-застосунку контакт@email" (будь-який текст із
# реальним email).
SEC_EDGAR_USER_AGENT=ai-invest-agent brokerdata2022@gmail.com

# --- Twelve Data (ціна/обсяг акцій, для скринінгу) ---
# Безкоштовна реєстрація: https://twelvedata.com/ (email+пароль, без
# капчі, ключ одразу в кабінеті). Ліміти free tier: ~8 запитів/хв,
# 800/добу.
TWELVEDATA_API_KEY=

# --- Binance / CoinGecko (крипта: BTC/ETH/SOL) ---
# Ключ не потрібен, обидва ендпоінти публічні без реєстрації.

# --- EIA (запаси нафти й газу, видобуток OPEC, газ США — факторні ряди) ---
# ПОТРІБЕН (безкоштовно): https://www.eia.gov/opendata/register.php
# Без нього адаптер падає на спільний DEMO_KEY, який живо вичерпався
# за кілька запитів (2026-10-20).
EIA_API_KEY=

# --- MET Norway (друге джерело прогнозу погоди для звірки) ---
# Ключ не потрібен, але умови сервісу вимагають User-Agent із
# контактом (інакше 403). Порожньо — береться SEC_EDGAR_USER_AGENT.
MET_NORWAY_USER_AGENT=

# CoinMetrics, blockchain.info, Etherscan (CSV графіка), Farside,
# DefiLlama, SPDR GLD, iShares IAU, ICE, USDA PSD (архів), Мінфін
# Японії, Ethereum Beacon (publicnode), Solana RPC, Open-Meteo —
# ключі не потрібні.

# --- PostgreSQL / TimescaleDB ---
# DB_HOST=localhost — для підключення з хоста (psql, VSCode PostgreSQL
# extension). Контейнер app всередині docker compose підключається
# до бази за іменем сервісу "db" автоматично (перевизначено в
# docker-compose.yml), це значення тут можна не чіпати.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=invest_agent
DB_USER=invest_agent
DB_PASSWORD=

# --- LLM: ДВА провайдери одночасно ---
# Який виклик іде куди — НЕ тут, а в config.py розділ 9
# (`LLM_ROUTES`): Opus 5 для прогнозу, Sonnet 5 для висновків, які
# читає людина, DeepSeek для механіки (фільтр релевантності,
# консолідація, дедуп, екстракція тикерів). Обидва ключі потрібні.

# DeepSeek — механіка (найбільше викликів) + резерв, якщо Anthropic
# недоступний (llm_common.call_llm).
DEEPSEEK_API_KEY=

# Anthropic — прогноз і висновки (console.anthropic.com).
ANTHROPIC_API_KEY=

# АВАРІЙНЕ перекриття ВСІХ маршрутів одразу — "deepseek" переводить
# увесь агент на дешевого провайдера (скінчився бюджет, Anthropic
# лежить), "anthropic" — навпаки. ПОРОЖНЄ (закомментоване) = нормальний
# режим, маршрути з config.py. Не спосіб налаштування, а важіль на
# випадок аварії.
# SYNTHESIS_LLM_PROVIDER=deepseek

# --- Telegram ---
# Бот: створити через @BotFather, TELEGRAM_CHAT_ID — id чату/користувача,
# кому бот надсилатиме повідомлення (можна дізнатись через @userinfobot
# або getUpdates після першого повідомлення боту).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Оркестрація (orchestration/, сервіс scheduler) ---
# Необов'язково: перекриває часовий пояс розкладу (за замовчуванням
# Europe/Kyiv, orchestration/schedule.py).
SCHEDULER_TIMEZONE=

# ─── Позначка середовища (необов'язкова) ───────────────────────────
# У ПРОДАКШЕНІ не задавати (або лишити порожнім) — агент має надсилати
# повідомлення як завжди.
#
# AGENT_ENV=dev  у дев-копії робить одну річ: reporting/telegram_client.py
# НЕ надсилає нічого живому боту (прогін доходить до кінця, доставка
# пропускається з попередженням у лозі).
#
# Навіщо (живий випадок 2026-10-16): дев і продакшен використовують ОДИН
# токен бота, і ручний прогін у деві надіслав користувачу відповідь,
# зібрану з дев-бази — знімка триденної давності, зовні невідрізнимого
# від справжнього звіту.
# AGENT_ENV=dev
